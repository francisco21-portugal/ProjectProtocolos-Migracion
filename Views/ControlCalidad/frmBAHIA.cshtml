@{
    ViewData["Title"] = "BAHIA";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section Scripts {


    <script>
         var id_producto;
         var id_lote;
         var item_descarga_final;
        // al abrir la pagina
        $(document).ready(function() {
            ufn_TablaCargarColumna();
        });

            // Limpiar validación al cerrar modales
        $('.modal').on('hidden.bs.modal', function() {
            // Remover clases de validación
            $(this).find('.form-control, .form-select').removeClass('is-invalid');
            // Resetear formularios
            $(this).find('form')[0]?.reset();
        });

                    // remueve el invalido si encuentra un valor en el campo
        $('#ModalCrearProtocolos').on('input change', '.form-control, .form-select', function() {
                if ($(this).val()) {
                    $(this).removeClass('is-invalid');
                }
        });

        // CADA VEZ QUE SE ABRE EL MODAL
        $("#ModalCrearProtocolos").on("show.bs.modal", function() {
            cbo_ListarProductos(null);
        });
        function ufn_TablaCargarColumna() {

            const startTime = Date.now();
            let dataLoaded = false;
            mostrarOverlay();
            // El filtro de tipo se aplica sobre los datos ya cargados.
            // El filtro de fecha se aplica en la base de datos.
            //$.fn.dataTable.ext.search =
           //     $.fn.dataTable.ext.search.filter(function (funcion) {
           //         return funcion !== filtrarPorTipoMovimiento &&
           //                funcion !== filtrarPorFecha;
             //   });

           // $.fn.dataTable.ext.search.push(filtrarPorTipoMovimiento);
          //  $.fn.dataTable.ext.search.push(filtrarPorFecha);

            if ($.fn.DataTable.isDataTable("#tblMovimientos")) {
                $("#tblMovimientos").DataTable().clear().destroy();
            }

            $("#tblMovimientos").DataTable({
                ajax: {
                    url: '@Url.Action("CC_ListarProductosPorCategoria_Controller", "ControlCalidad")',
                    type: "GET",
                    data: {
                        idCategoria: 104
                    },
                    dataType: "json",
                    dataSrc: function (response) {
                        if (!response || !Array.isArray(response.data)) { return []; }
                        return response.data;
                    },
                    error: function (xhr, status, error) {
                        console.error("Error real al cargar los movimientos:", status, error,xhr.responseText);
                        ocultarOverlay();
                        Swal.fire({
                            title: "Error",
                            text: "No se pudieron cargar los movimientos.",
                            icon: "error",
                            confirmButtonText: "Aceptar"
                        });
                    }
                },
                columns: [
                    {   data: "productoNombre",defaultContent: "" },
                    {   data: "codigoProducto", defaultContent: "" },
                    {   data: "iDusuario", defaultContent: "" },
                    {   data: "fechaIngreso", defaultContent: "--",
                        render: function (data) {
                            if (!data) { return "--"; }
                            return String(data).replace("T", " ");
                        }
                    },
                    {  "render": function (data, type, row) {
                        return `<div class="dropdown actions-dropdown">

                                <button class="btn btn-sm"
                                        type="button"
                                        id="dropdownMenuButton1"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        style="cursor:pointer;">
                                    <i class="bi bi-three-dots-vertical" style="font-size:1.2rem;"></i>
                                </button>
                                <ul class="dropdown-menu shadow" aria-labelledby="dropdownMenuButton1">
                                    <li>
                                        <a class="dropdown-item fs-6 py-2"
                                            style="cursor:pointer;"
                                            onclick="ufn_CargaProtocolos(${row.codigoProducto})"
                                            data-bs-toggle="modal"
                                            data-bs-target="#ModalListaProtocolos">
                                            <i class="bi bi-view-stacked me-2" style="font-size:1.1rem;"></i>
                                            Ver protocolos
                                        </a>
                                    </li>
                                </ul>
                        </div>`;
                        }
                    }
                ],
                language: {
                    url: "https://cdn.datatables.net/plug-ins/2.1.5/i18n/es-MX.json",
                    lengthMenu: "Mostrar _MENU_ registros por página",
                    emptyTable: "No hay movimientos registrados para la fecha seleccionada.",
                    zeroRecords: "No se encontraron registros."
                },
                lengthMenu: [ [10, 25, 50, 100], ["10", "25", "50", "100"] ],
                processing: true,
                scrollY: "55vh",
                scrollCollapse: true,
                scrollX: true,
                columnDefs: [ { targets: [2], visible: false } ],
                initComplete: function () {
                    dataLoaded = true;
                    // Recuperar los filtros generales después de recargar por fecha.
                   // aplicarFiltros();
                    checkAndHideOverlay(startTime);
                },
                drawCallback: function () {
                    if (!dataLoaded && this.api().ajax.json()) {
                        dataLoaded = true;
                        checkAndHideOverlay(startTime);
                    }
                }
            });
        };


        function ufn_CargaProtocolos(Valor) {
            
            const startTime = Date.now();
            let dataLoaded = false;
            mostrarOverlay();
            // El filtro de tipo se aplica sobre los datos ya cargados.
            // El filtro de fecha se aplica en la base de datos.
            //$.fn.dataTable.ext.search =
           //     $.fn.dataTable.ext.search.filter(function (funcion) {
           //         return funcion !== filtrarPorTipoMovimiento &&
           //                funcion !== filtrarPorFecha;
             //   });

           // $.fn.dataTable.ext.search.push(filtrarPorTipoMovimiento);
          //  $.fn.dataTable.ext.search.push(filtrarPorFecha);

            if ($.fn.DataTable.isDataTable("#tblMovimientosProtocolos")) {
                $("#tblMovimientosProtocolos").DataTable().clear().destroy();
            }

            $("#tblMovimientosProtocolos").DataTable({

                ajax: {
                    url: '@Url.Action("CC_BuscarProtocolosPorProducto_Controller", "ControlCalidad")',
                    type: "GET",
                    data: {
                        Codigo: Valor
                    },
                    dataType: "json",
                    dataSrc: function (response) {
                        if (!response || !Array.isArray(response.data)) { return []; }
                        return response.data;
                    },
                    error: function (xhr, status, error) {
                        console.error("Error real al cargar los movimientos:", status, error,xhr.responseText);
                        ocultarOverlay();
                        Swal.fire({
                            title: "Error",
                            text: "No se pudieron cargar los movimientos.",
                            icon: "error",
                            confirmButtonText: "Aceptar"
                        });
                    }
                },
                columns: [
                    {   data: "iDproducto", defaultContent: "" },
                    {   data: "archivo",defaultContent: "" },
                    {   data: "codigo", defaultContent: "" },
                    {   data: "lote", defaultContent: "" },
                    {   data: "fechaIngreso", defaultContent: "--",
                        render: function (data) {
                            if (!data) { return "--"; }
                            return String(data).replace("T", " ");
                        }
                    },
                    {   data: "idProducto",
                        render: function (data) {
                            return `
                                <button class="btn btn-sm btn-primary"
                                    onclick="ufnVerPDF(${data})">
                                    <i class="fas fa-file-pdf"></i> Ver PDF
                                </button>
                            `;
                        }
                    }

                ],
                language: {
                    url: "https://cdn.datatables.net/plug-ins/2.1.5/i18n/es-MX.json",
                    lengthMenu: "Mostrar _MENU_ registros por página",
                    emptyTable: "No hay movimientos registrados para la fecha seleccionada.",
                    zeroRecords: "No se encontraron registros."
                },
                lengthMenu: [ [10, 25, 50, 100], ["10", "25", "50", "100"] ],
                processing: true,
                scrollY: "55vh",
                scrollCollapse: true,
                scrollX: true,
                columnDefs: [ { targets: [0], visible: false } ],
                initComplete: function () {
                    dataLoaded = true;
                    // Recuperar los filtros generales después de recargar por fecha.
                   // aplicarFiltros();
                    checkAndHideOverlay(startTime);
                },
                drawCallback: function () {
                    if (!dataLoaded && this.api().ajax.json()) {
                        dataLoaded = true;
                        checkAndHideOverlay(startTime);
                    }
                }
            });
        };

        function cbo_ListarProductos(idSeleccionado = null) {
            $.ajax({
                url: '@Url.Action("CC_ListarProductosPorCategoria_Controller", "ControlCalidad")',
                type: "GET",
                data: {
                    idCategoria: 104
                },
                dataType: "json",
                success: function (response) {
                    const select = $("#cboNombreProducto");

                    // Destruir TomSelect antes de modificar el select original.
                    if (select[0].tomselect) {
                        select[0].tomselect.destroy();
                    }

                    select.empty().append('<option value="">Seleccionar</option>');

                    $.each(response.data || [], function (i, elemento) {
                        select.append(
                            $("<option>")
                                .val(elemento.codigoProducto)
                                .attr("data-codigoproducto", elemento.codigoProducto)
                                .text(elemento.productoNombre)
                        );
                    });

                    const ts = new TomSelect("#cboNombreProducto", {
                        placeholder: "Buscar Producto...",
                        maxOptions: null,
                        searchField: ["text","codigoproducto"],
                        create: false
                    });

                    ts.on("change", function () {
                        ts.wrapper.classList.remove("is-invalid");
                    });

                    if (idSeleccionado != null) {
                        ts.setValue(idSeleccionado);
                        select.trigger("change");
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error cargando combo:", status, error, xhr.responseText);
                }
            });
        }


        $("#cboNombreProducto").on("change", function () {
            var opcion = $("#cboNombreProducto option:selected");
            if ($(this).val() !== "") {
                var xcodigoProducto = opcion.data("codigoproducto");
                $("#txtCodigoProducto").val(xcodigoProducto);
            } else {
                $("#txtCodigoProducto").val("");
            }
        });

        function ufnVerPDF(IDproducto) {
            window.open(
                `/ControlCalidad/VerPDF_Controller?IDproducto=${IDproducto}`,
                '_blank'
            );
        }


    </script>

}





<body>
    <div class="container-fluid">
        <!-- Encabezado -->
        <div class="header py-1">
            <h1 class="page-title">PRODUCTOS BAHIA</h1>
            <p class="page-subtitle mb-0 small">Mantenimientos bahia.</p>
        </div>
        <!-- Botones de acción -->
        <div class="row mb-2">
            <div class="col-md-12 mb-6">
                <button type="button" class="btn btn-primary-type btn-action w-100" data-bs-toggle="modal" data-bs-target="#ModalCrearProtocolos">
                    <i class="bi bi-plus-circle"></i>
                    CARGAR PROTOCOLO BAHIA
                </button>

            </div>
        </div>
        <!-- Tabla -->
        <div class="search-filters">
            <!-- FILTROS DE BÚSQUEDA POR COLUMNA -->
            <div class="filtros-tabla mb-3">
                <div class="row g-2">
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="filter-label" for="filtroCodigo">Cod. Producto</label>
                        <input type="text" class="form-control form-control-sm" id="filtroCodigo" placeholder="Buscar por código" />
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="filter-label" for="filtroProducto">Producto Desc.</label>
                        <input type="text" class="form-control form-control-sm" id="filtroProducto" placeholder="Buscar por producto" />
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="filter-label" for="filtroFechaDesde">Fecha desde</label>
                        <input type="date" class="form-control form-control-sm" id="filtroFechaDesde" />
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="filter-label" for="filtroFechaHasta">Fecha hasta</label>
                        <input type="date" class="form-control form-control-sm" id="filtroFechaHasta" />
                    </div>
                </div>
            </div>
            <!-- Tabla de estándares -->
            <div class="data-table-container">
                <div class="table-header">
                    <h3 class="table-title">LISTA PRODUCTOS</h3>
                    <button type="button" class="btn btn-secondary btn-sm" id="btnLimpiarFiltros">
                        <i class="bi bi-eraser"></i> Limpiar filtros
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover" id="tblMovimientos">
                        <thead>
                            <tr>
                                
                                <th>PRODUCTO</th>
                                <th>CODIGO PRODUCTO</th>
                                <th>ID USUARIO</th>
                                <th>FECHA REGISTRO</th>
                                <th>...</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- CARGAR PROTOCOLO - FORMULARIO -->
        <div class="modal fade" id="ModalCrearProtocolos" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="ModalCrearProtocolosLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="ModalCrearProtocolosLabel">CARGAR PROTOCOLOS DE PRODUCTOS BAHIA</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form id="frmProtocolo">
                            <div class="row">
                                <div class="col-md-12 mb-6">
                                    <label for="cboNombreProducto" class="form-label required-field">PRODUCTO</label>
                                    <select class="form-select" id="cboNombreProducto">
                                        <option value="" selected disabled>Seleccione PRODUCTO</option>
                                    </select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="txtCodigoProducto" class="form-label required-field">CODIGO PRODUCTO</label>
                                    <input type="text" class="form-control" id="txtCodigoProducto" placeholder="0000000" readonly required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="txtLote" class="form-label required-field">LOTE</label>
                                    <input type="text" maxlength="100" class="form-control" id="txtLote" placeholder="Ingrese lote" required>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12 mb-6">
                                    <label for="txtArchivo" class="form-label required-field">ARCHIVO </label>
                                    <input type="file" class="form-control" id="txtArchivo" placeholder="Seleccione archivo" required>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12 mb-6">
                                    <label for="txtRutaArchivo" class="form-label required-field">RUTA DEL ARCHIVO </label>
                                    <input type="text" class="form-control" id="txtRutaArchivo" placeholder="Carga Ruta Automaticamente" readonly required>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn btn-primary" id="savePrimaryBtn">Ingresa Protocolo</button>
                    </div>
                </div>
            </div>
        </div>




        <style>
            #ModalListaProtocolos .protocolos-modal-content {
                overflow: hidden;
                border: 1px solid var(--border-color);
                border-radius: 16px;
                box-shadow: 0 16px 48px rgba(0, 0, 0, 0.18);
            }

            #ModalListaProtocolos .protocolos-modal-header {
                padding: 1.25rem 1.5rem;
                color: var(--primary-color);
                background: linear-gradient(135deg, #fff, var(--light-bg));
                border-bottom: 1px solid var(--border-color);
            }

                #ModalListaProtocolos .protocolos-modal-header .modal-title {
                    font-weight: 700;
                    text-transform: capitalize;
                }

                #ModalListaProtocolos .protocolos-modal-header small {
                    color: var(--secondary-color);
                }

            #ModalListaProtocolos .protocolos-modal-icon,
            #ModalListaProtocolos .protocolos-section-icon {
                display: grid;
                place-items: center;
                color: var(--primary-color);
                background-color: rgba(44, 120, 115, 0.1);
                border-radius: 12px;
            }

            #ModalListaProtocolos .protocolos-modal-icon {
                width: 48px;
                height: 48px;
                font-size: 1.4rem;
            }

            #ModalListaProtocolos .protocolos-section-icon {
                width: 38px;
                height: 38px;
                font-size: 1.1rem;
            }

            #ModalListaProtocolos .protocolos-modal-body {
                padding: 1.5rem;
                background-color: #fcfdfd;
            }

            #ModalListaProtocolos .protocolos-filter-panel {
                padding: 1.25rem;
                margin-bottom: 1.25rem;
                background-color: var(--light-bg);
                border: 1px solid var(--border-color);
                border-radius: 12px;
            }

                #ModalListaProtocolos .protocolos-filter-panel h6 {
                    color: var(--primary-color);
                    font-weight: 700;
                }

                #ModalListaProtocolos .protocolos-filter-panel .form-control {
                    min-height: 40px;
                    border-color: #d7e2e1;
                    border-radius: 8px;
                }

                    #ModalListaProtocolos .protocolos-filter-panel .form-control:focus {
                        border-color: var(--primary-color);
                        box-shadow: 0 0 0 0.2rem rgba(44, 120, 115, 0.15);
                    }

            #ModalListaProtocolos .protocolos-table-container {
                border: 1px solid var(--border-color);
                border-radius: 12px;
            }

            #ModalListaProtocolos .protocolos-table-header {
                padding: 1rem 1.25rem;
                background-color: #f8f9fa;
            }

                #ModalListaProtocolos .protocolos-table-header .table-title {
                    margin-bottom: 0.2rem;
                    font-size: 1rem;
                }

            #ModalListaProtocolos .protocolos-modal-footer {
                padding: 1rem 1.5rem;
                background-color: var(--light-bg);
                border-top: 1px solid var(--border-color);
            }


        </style>
        <div class="modal fade" id="ModalListaProtocolos" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="ModalListaProtocolosLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable protocolos-modal-dialog">
                <div class="modal-content protocolos-modal-content">
                    <div class="modal-header protocolos-modal-header">
                        <div class="d-flex align-items-center gap-3">
                            <div class="protocolos-modal-icon">
                                <i class="bi bi-folder2-open"></i>
                            </div>
                            <div>
                                <h5 class="modal-title" id="ModalListaProtocolosLabel">Lista de protocolos</h5>
                                <small>Consulta y descarga de protocolos del producto</small>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>

                    <div class="modal-body protocolos-modal-body">
                        <div class="search-filters protocolos-filter-panel">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-funnel protocolos-section-icon"></i>
                                <div>
                                    <h6 class="mb-0">Filtros de búsqueda</h6>
                                    <small class="text-muted">Filtra los protocolos por producto o fecha</small>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-md-6 col-lg-3">
                                    <label class="filter-label" for="filtroCodigo">Código de producto</label>
                                    <input type="text" class="form-control" id="filtroCodigo" placeholder="Buscar por código" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-3">
                                    <label class="filter-label" for="filtroProducto">Producto</label>
                                    <input type="text" class="form-control" id="filtroProducto" placeholder="Buscar por producto" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-3">
                                    <label class="filter-label" for="filtroFechaDesde">Fecha desde</label>
                                    <input type="date" class="form-control" id="filtroFechaDesde" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-3">
                                    <label class="filter-label" for="filtroFechaHasta">Fecha hasta</label>
                                    <input type="date" class="form-control" id="filtroFechaHasta" />
                                </div>
                            </div>
                        </div>

                        <div class="data-table-container protocolos-table-container">
                            <div class="table-header protocolos-table-header">
                                <div>
                                    <h3 class="table-title">Protocolos</h3>
                                    <small class="text-muted">Documentos registrados para el producto</small>
                                </div>
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnLimpiarFiltros">
                                    <i class="bi bi-eraser me-1"></i>Limpiar filtros
                                </button>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0" id="tblMovimientosProtocolos">
                                    <thead>
                                        <tr>
                                            <th>ID producto</th>
                                            <th>Archivo</th>
                                            <th>Código</th>
                                            <th>Lote</th>
                                            <th>Fecha de ingreso</th>
                                            <th>PDF</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer protocolos-modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-lg me-1"></i>Cancelar
                        </button>
                        <button type="button" class="btn btn-primary" id="saveDescargaFinalBtn">
                            <i class="bi bi-check-lg me-1"></i>Guardar Descarga Final
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>