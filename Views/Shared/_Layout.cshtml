    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>


    <script src="~/js/AsistenteAIScript.js" asp-append-version="true"></script>

    @*jquery y datatable*@
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.datatables.net/2.3.1/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/dataTables.buttons.js"></script>
    <script src="https://cdn.datatables.net/fixedheader/4.0.1/js/dataTables.fixedHeader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <!-- AGREGADO: JavaScript mejorado para manejo de niveles -->
    <script>
        const sidebar = document.getElementById("sidebar");
        const toggleBtn = document.getElementById("btnToggle");

        // FUNCIÓN PARA CERRAR SUBMENÚS POR NIVEL (Para efecto acordeón al hacer click)
        function closeGroupsByLevel(currentElement, targetLevel) {
            const allGroups = document.querySelectorAll('.nav-group');
            allGroups.forEach(group => {
                let level = 1;
                let parent = group.parentElement.closest('.nav-group');
                while (parent) {
                    level++;
                    parent = parent.parentElement.closest('.nav-group');
                }
                if (level >= targetLevel && group !== currentElement) {
                    group.classList.remove('show');
                }
            });
        }

        // FUNCIÓN PARA EXPANDIR LA RUTA ACTIVA
        function expandActivePath() {
            if (sidebar.classList.contains("collapsed")) return;

            const activeLink = document.querySelector('.sidebar .nav-link.active');
            if (activeLink) {
                let parentGroup = activeLink.closest('.nav-group');
                while (parentGroup) {
                    parentGroup.classList.add('show');
                    parentGroup.classList.add('show-active');
                    const parentList = parentGroup.parentElement;
                    parentGroup = parentList ? parentList.closest('.nav-group') : null;
                }
            }
        }

        // FUNCIÓN PARA INICIALIZAR EL MENÚ ACTIVO
        function initActiveMenu() {
            const currentPath = window.location.pathname.toLowerCase();
            let found = false;

            // Ordenar enlaces para evaluar primero las rutas más específicas
            const links = Array.from(document.querySelectorAll('.sidebar .nav-link'));
            links.sort((a, b) => {
                const hrefA = a.getAttribute('href') || '';
                const hrefB = b.getAttribute('href') || '';
                return hrefB.length - hrefA.length;
            });

            for (const link of links) {
                const href = link.getAttribute('href');
                if (!href || href === '#' || href.startsWith('javascript:')) continue;

                let linkPath = href.toLowerCase();
                try {
                    const resolvedUrl = new URL(href, window.location.origin);
                    linkPath = resolvedUrl.pathname.toLowerCase();
                } catch(e) {}

                if (currentPath === linkPath || (linkPath !== '/' && currentPath === linkPath + '/')) {
                    link.classList.add('active');
                    found = true;
                    break;
                }
            }

            if (!found) {
                for (const link of links) {
                    const href = link.getAttribute('href');
                    if (!href || href === '#' || href === '/' || href.startsWith('javascript:')) continue;

                    let linkPath = href.toLowerCase();
                    try {
                        const resolvedUrl = new URL(href, window.location.origin);
                        linkPath = resolvedUrl.pathname.toLowerCase();
                    } catch(e) {}

                    if (currentPath.startsWith(linkPath)) {
                        link.classList.add('active');
                        found = true;
                        break;
                    }
                }
            }

            expandActivePath();
        }

        // MANEJADOR DE CLICS EN LOS TOGGLES DE GRUPOS (multinivel)
        document.querySelectorAll(".nav-group-toggle").forEach(toggle => {
            toggle.addEventListener("click", function(e) {
                e.preventDefault();
                e.stopPropagation();

                if (sidebar.classList.contains("collapsed")) return;

                const currentGroup = this.closest(".nav-group");
                if (!currentGroup) return;

                let currentLevel = 1;
                let parent = currentGroup.parentElement.closest('.nav-group');
                while (parent) {
                    currentLevel++;
                    parent = parent.parentElement.closest('.nav-group');
                }

                const isOpen = currentGroup.classList.contains("show");

                if (isOpen) {
                    currentGroup.classList.remove("show");
                    return;
                }

                closeGroupsByLevel(currentGroup, currentLevel);
                currentGroup.classList.add("show");
            });
        });

        // BOTÓN DE TOGGLE DE SIDEBAR (Unificado para móvil y escritorio)
        toggleBtn.onclick = () => {
            if (sidebar.classList.contains("collapsed")) {
                sidebar.classList.remove("collapsed");
                expandActivePath();
            } else {
                sidebar.classList.add("collapsed");
                // Cerrar todos los submenús al colapsar para mantener los iconos limpios
                document.querySelectorAll('.nav-group').forEach(g => {
                    g.classList.remove("show");
                    g.classList.remove("show-active");
                });
            }
        };

        // EXPANDIR EL MENÚ HACIENDO CLIC EN EL LOGO DEL SISTEMA CUANDO ESTÁ COLAPSADO
        const logoSistema = document.getElementById("logoSistema");
        if (logoSistema) {
            logoSistema.addEventListener("click", function (e) {
                if (sidebar.classList.contains("collapsed")) {
                    e.stopPropagation();
                    sidebar.classList.remove("collapsed");
                    expandActivePath();
                }
            });
        }

        // Al iniciar en móvil, forzar que inicie colapsado
        if (window.innerWidth <= 768) {
            sidebar.classList.add("collapsed");
        }

        // Ejecutar inicialización del menú al cargar
        initActiveMenu();

        // =====================================================================
        // CARGAR NOMBRE DEL USUARIO DESDE LOCALSTORAGE
        // El nombre se guardó en localStorage['user'] al momento del login
        // (Index.cshtml guarda: nombres + apellidos del JSON de la API).
        // =====================================================================
        (function cargarNombreUsuario() {
            var lblNombre = document.getElementById('lblNombreUsuario');
            if (lblNombre) {
                var nombreGuardado = localStorage.getItem('user');
                // Si existe el nombre en localStorage lo mostramos; si no, usamos un valor por defecto
                lblNombre.textContent = nombreGuardado ? nombreGuardado : 'USUARIO';
            }
        })();

        // CERRAR SESIÓN
        function Cerrar() {
            $.ajax({
                url: "@Url.Action("CerrarSesion_Controller", "Home")",
                type: "post",
                data: { xValor: "1" },
                success: function (response) {
                    window.location.href = '/Home/Index';
                },
                error: function (xhr, status, error) {
                    alert('Error al intentar cerrar sesión' + error);
                }
            });
        }


        /* consulta de probabilidaddes*/

        $(document).on("click", ".ia-suggestion", function () {
            const pregunta = $(this).data("pregunta");

            $("#txtPreguntaIA")
                .val(pregunta)
                .focus();
        });

        $("#txtPreguntaIA").on("input", function () {
            $(this).removeClass("is-invalid");
        });

        $("#btnConsultarIA").on("click", function () {
            const pregunta = $("#txtPreguntaIA").val()?.trim() || "";
            const respuesta = $("#contenedorRespuestaIA");
            const boton = $(this);

            if (!pregunta) {
                $("#txtPreguntaIA")
                    .addClass("is-invalid")
                    .focus();

                return;
            }

            boton.prop("disabled", true);

            respuesta.html(`
                <div class="ia-response-icon">
                    <span class="spinner-border spinner-border-sm"></span>
                </div>
                <div>
                    <strong>Consultando información...</strong>
                    <p class="mb-0">Espere un momento.</p>
                </div>
            `);

            $.ajax({
                url: "/Asistente/Consultar",
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify({
                    pregunta: pregunta
                }),
                success: function (response) {
                    respuesta.html(`
                        <div class="ia-response-icon">
                            <i class="bi bi-check-circle"></i>
                        </div>
                        <div>
                            <strong>Respuesta</strong>
                            <p class="mb-0">${escapeHtml(response.respuesta || "--")}</p>
                        </div>
                    `);
                },
                error: function () {
                    respuesta.html(`
                        <div class="ia-response-icon text-danger">
                            <i class="bi bi-exclamation-circle"></i>
                        </div>
                        <div>
                            <strong>No se pudo completar la consulta</strong>
                            <p class="mb-0">Intente nuevamente.</p>
                        </div>
                    `);
                },
                complete: function () {
                    boton.prop("disabled", false);
                }
            });
        });

        function escapeHtml(valor) {
            return $("<div>").text(valor ?? "--").html();
        }
    </script>
</body>
</html>