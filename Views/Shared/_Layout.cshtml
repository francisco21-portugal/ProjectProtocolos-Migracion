                <a class="nav-link nav-group-toggle">
                    <i class="bi bi-person-fill nav-icon"></i>
                    <!-- Nombre del usuario logueado: se lee desde localStorage (guardado al hacer login) -->
                    <span class="menu-text"><b id="lblNombreUsuario"> ... </b></span>
                </a>
            </li>

        </ul>
        <ul class="nav flex-column">
            <!-- ITEM NORMAL INFORMACION DEL SISTEMA -->
            <!-- idFuncionalidad 133 = INFORMACION (nivel 1 - sin hijos, enlace directo) -->
