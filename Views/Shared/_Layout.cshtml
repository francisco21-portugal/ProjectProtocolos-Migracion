                                <i class="bi bi-caret-down-fill ms-auto"></i>
                            </a>
                            <!-- NIVEL 2 -->
                            <ul class="nav-group-items list-unstyled nav-group-level3" style="padding-left: 1.5rem;">
                                
                                @if (HasFuncionalidad(244))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" asp-action="frmBAHIA" asp-controller="ControlCalidad">
                                            <i class="bi bi-clipboard2-check nav-icon"></i>BAHIA
                                        </a>
                                    </li>
                                }
                                
                                @if (HasFuncionalidad(245))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" asp-action="frmBEBES" asp-controller="ControlCalidad">
                                            <i class="bi bi-upload nav-icon"></i>BEBES
                                        </a>
                                    </li>
                                }
                                
                                @if (HasFuncionalidad(246))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" asp-action="frmCOSMETICOS" asp-controller="ControlCalidad">
                                            <i class="bi bi-upload nav-icon"></i>COSMÉTICOS
                                        </a>
                                    </li>
                                }
                                
                                @if (HasFuncionalidad(247))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" asp-action="frmESTADO" asp-controller="ControlCalidad">
                                            <i class="bi bi-upload nav-icon"></i>ESTADO
                                        </a>
                                    </li>
                                }
                                
                                @if (HasFuncionalidad(248))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" asp-action="frmGALENICOS" asp-controller="ControlCalidad">
                                            <i class="bi bi-upload nav-icon"></i>GALÉNICOS
                                        </a>
                                    </li>
                                }
                                @if (HasFuncionalidad(249))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" asp-action="frmGENERICOS" asp-controller="ControlCalidad">
                                            <i class="bi bi-upload nav-icon"></i>GENÉRICOS
                                        </a>
                                    </li>
                                }
                                @if (HasFuncionalidad(250))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" asp-action="frmLINEACOMERCIALTD" asp-controller="ControlCalidad">
                                            <i class="bi bi-upload nav-icon"></i>LINEA COMERCIAL TD
                                        </a>
                                    </li>
                                }
                                @if (HasFuncionalidad(251))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" asp-action="frmLINEACOMERCIALVM" asp-controller="ControlCalidad">
                                            <i class="bi bi-download nav-icon"></i>LINEA COMERCIAL VM
                                        </a>
                                    </li>
                                }
                                @if (HasFuncionalidad(252))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" asp-action="frmMAQUILA" asp-controller="ControlCalidad">
                                            <i class="bi bi-download nav-icon"></i>MAQUILA
                                        </a>
                                    </li>
                                }
                                @if (HasFuncionalidad(253))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" asp-action="frmNATURALES" asp-controller="ControlCalidad">
                                            <i class="bi bi-download nav-icon"></i>NATURALES
                                        </a>
                                    </li>
                                }
                                @if (HasFuncionalidad(254))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" asp-action="frmVARIOS" asp-controller="ControlCalidad">
                                            <i class="bi bi-download nav-icon"></i>VARIOS
                                        </a>
                                    </li>
                                }
                                @if (HasFuncionalidad(255))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" asp-action="frmYUMAX" asp-controller="ControlCalidad">
                                            <i class="bi bi-download nav-icon"></i>YUMAX
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }

                </ul>
            </li>

            <!-- AUDITORIA - NIVEL 1 (idFuncionalidad 138) showAuditGroup = HasFuncionalidad(138) -->
            @if (showAuditoria)
            {
                <li class="nav-item nav-group">
                    <a class="nav-link nav-group-toggle">
                        <i class="bi bi-person-lines-fill nav-icon"></i>
                        <span class="menu-text">AUDITORIA</span>
                        <i class="bi bi-caret-down-fill ms-auto"></i>
                    </a>
                    <ul class="nav-group-items list-unstyled">
                        <!-- idFuncionalidad 160 = AUDITORIA > USUARIOS | ruta: AuditTrail/AuditUsuarios -->
                        @if (HasFuncionalidad(258))
                        {
                            <li class="nav-item"><a class="nav-link" asp-action="AuditUsuarios" asp-controller="AuditTrail"><i class="bi bi-person-lines-fill nav-icon"></i>USUARIOS</a></li>
                        }
