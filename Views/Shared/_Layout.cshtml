<body>
    @{
        bool isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
        // Leer todos los ids de funcionalidad de los claims de sesión
        var funcIds = isAuthenticated ? User.Claims.Where(c => c.Type == "funcionalidad").Select(c => c.Value).ToHashSet()   // HashSet para búsqueda O(1)
        : new HashSet<string>();

        // Función auxiliar: devuelve true si el usuario tiene la funcionalidad con ese id.
        // Se usa en cada @if del menú para decidir si mostrar o no el item.
        bool HasFuncionalidad(int id) => funcIds.Contains(id.ToString());

        // -- Grupos de nivel 1 (se muestran si el usuario tiene AL MENOS el id del grupo padre) --
        // El grupo CONFIGURACIONES (134) se muestra si tiene alguno de sus hijos
        bool showPadre = HasFuncionalidad(243);
        bool showAuditoria = HasFuncionalidad(257);
        // bool showControlGroup = HasFuncionalidad(135) || HasFuncionalidad(152);
    }




