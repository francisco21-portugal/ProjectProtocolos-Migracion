        </ul>

        <!-- CERRAR SESIÓN AL FINAL -->
        <div class="sidebar-footer mt-auto">
            <a class="nav-link text-danger fw-bold d-flex align-items-center" href="#">
                <i class="bi bi-box-arrow-right nav-icon"></i>
                <span class="menu-text" id="btnCerrarSesion" onclick="Cerrar()">Cerrar sesión</span>
            </a>
        </div>
    </nav>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="main-content">

        @RenderBody()
    </main>

    <div class="ia-agent-wrapper">
        <button type="button" class="ia-agent-trigger border-0" data-bs-toggle="modal" data-bs-target="#modalAsistenteIA" title="Abrir asistente">
            <i class="bi bi-robot"></i>
        </button>
        <div class="ia-agent-tooltip">
            <strong>Asistente IA Portugal</strong><br> Consultas sobre inventario y control de calidad.
        </div>
    </div>
    <div class="modal fade ia-modal" id="modalAsistenteIA" tabindex="-1" aria-labelledby="modalAsistenteIALabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content ia-modal-content">
                <div class="ia-modal-header">
                    <div class="ia-brand">
                        <div class="ia-brand-icon"> <i class="bi bi-robot"></i> </div>
                        <div>
                            <h5 class="mb-0" id="modalAsistenteIALabel"> Asistente Portugal </h5>
                            <small>
                                <span class="ia-status-dot"></span> Disponible para ayudarte
                            </small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="ia-modal-body">
                    <div class="ia-welcome">
                        <div class="ia-welcome-icon"> <i class="bi bi-stars"></i> </div>
                        <div>
                            <h6>¿En qué puedo ayudarte?</h6>
                            <p class="mb-0"> Consulta información de inventario, reactivos y control de calidad. </p>
                        </div>
                    </div>
                    <div id="contenedorRespuestaIA" class="ia-response">
                        <div class="ia-response-icon"> <i class="bi bi-chat-left-text"></i> </div>
                        <div>
                            <strong>Realiza una consulta</strong>
                            <p class="mb-0">Ejemplo: ¿Cuántos reactivos tienen stock disponible? </p>
                        </div>
                    </div>
                    <div class="ia-suggestions">
                        <button type="button" class="ia-suggestion" data-pregunta="¿Cuántos reactivos tienen stock disponible?">
                            <i class="bi bi-box-seam"></i> Stock disponible
                        </button>
                        <button type="button" class="ia-suggestion" data-pregunta="¿Qué reactivos están próximos a vencer?">
                            <i class="bi bi-calendar-x"></i> Próximos a vencer
                        </button>
                        <button type="button" class="ia-suggestion" data-pregunta="¿Cuáles fueron los últimos movimientos?">
                            <i class="bi bi-clock-history"></i> Últimos movimientos
                        </button>
                    </div>
                    <div class="ia-input-container">
                        <textarea id="txtPreguntaIA" class="ia-question-input" rows="2" maxlength="500" placeholder="Escribe tu pregunta..."></textarea>
                        <button type="button" class="ia-send-button" id="btnConsultarIA" title="Enviar consulta">
                            <i class="bi bi-arrow-up"></i>
                        </button>
                    </div>
                    <div class="ia-security-note">
                        <i class="bi bi-shield-check"></i> El asistente solo consulta información autorizada del sistema.
                    </div>
                </div>
            </div>
